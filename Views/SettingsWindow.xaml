<Window x:Class="LumaClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumaClip 设置" Width="920" Height="760" MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Icon="/Assets/LumaClip.ico">
  <Grid Margin="12">
    <Grid.Background>
      <ImageBrush ImageSource="/Assets/GlassBackground.png" Stretch="UniformToFill"
                  Opacity="{DynamicResource BackdropImageOpacity}"/>
    </Grid.Background>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassSidebar}" Padding="12">
      <StackPanel>
        <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" Margin="10,10,0,20"/>
        <Button x:Name="GeneralNav" Style="{StaticResource NavButton}" Tag="general" Click="Section_Click" Background="{DynamicResource SelectedBrush}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/><TextBlock Text="常规与外观" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="PrivacyNav" Style="{StaticResource NavButton}" Tag="privacy" Click="Section_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource NavGlyph}"/><TextBlock Text="隐私与安全" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="FloatingNav" Style="{StaticResource NavButton}" Tag="floating" Click="Section_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource NavGlyph}"/><TextBlock Text="悬浮窗" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="StorageNav" Style="{StaticResource NavButton}" Tag="storage" Click="Section_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" Style="{StaticResource NavGlyph}"/><TextBlock Text="存储与备份" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <TextBlock Text="所有数据仅保存在本机" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="10,24,10,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource GlassInspector}" Padding="28" Effect="{StaticResource InspectorShadow}">
      <Grid>
        <ScrollViewer x:Name="GeneralSection" VerticalScrollBarVisibility="Auto" Margin="0,0,0,58">
          <StackPanel>
            <TextBlock Text="常规与外观" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="窗口、主题和全局快捷键" Style="{StaticResource Caption}" Margin="0,4,0,20"/>
            <TextBlock Text="主题" FontWeight="SemiBold"/>
            <ComboBox x:Name="ThemeCombo" Margin="0,8,0,18" Padding="10,7">
              <ComboBoxItem Content="跟随 Windows 系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
            </ComboBox>
            <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动"/>
            <CheckBox x:Name="MinimizedCheck" Content="启动时只显示在系统托盘"/>
            <CheckBox x:Name="ReducedMotionCheck" Content="减少动画（也会遵循 Windows 辅助功能设置）"/>
            <CheckBox x:Name="ReducedTransparencyCheck" Content="降低透明度和模糊强度"/>
            <TextBlock Text="全局快捷键" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="打开主窗口" Style="{StaticResource Caption}"/><TextBox x:Name="MainHotkeyBox" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="显示/隐藏悬浮窗" Style="{StaticResource Caption}"/><TextBox x:Name="FloatHotkeyBox" Margin="0,6,0,0"/></StackPanel>
            </Grid>
            <TextBlock Text="快捷键修改后将在下次启动时生效。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PrivacySection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,58">
          <StackPanel>
            <TextBlock Text="隐私与安全" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="决定哪些内容不会进入历史" Style="{StaticResource Caption}" Margin="0,4,0,20"/>
            <CheckBox x:Name="PauseCheck" Content="暂停剪贴板监听"/>
            <CheckBox x:Name="PrivacyCheck" Content="隐私模式（临时停止记录所有新内容）"/>
            <CheckBox x:Name="SensitiveCheck" Content="自动识别并隐藏密码、令牌、验证码和银行卡号"/>
            <TextBlock Text="排除的应用进程名" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBox x:Name="ExcludedAppsBox" AcceptsReturn="True" MinHeight="130" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
            <TextBlock Text="每行一个名称，支持部分匹配。例如 KeePass、1Password、Bitwarden。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button Content="将全部历史移入回收站" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="ClearHistory_Click"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="FloatingSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,58">
          <StackPanel>
            <TextBlock Text="悬浮窗" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="独立于主窗口的桌面剪贴板" Style="{StaticResource Caption}" Margin="0,4,0,20"/>
            <TextBlock Text="收起样式" FontWeight="SemiBold"/>
            <ComboBox x:Name="FloatStyleCombo" Margin="0,8,0,16" Padding="10,7">
              <ComboBoxItem Content="玻璃悬浮球"/>
              <ComboBoxItem Content="灵动岛"/>
            </ComboBox>
            <CheckBox x:Name="FloatTopCheck" Content="始终置顶"/>
            <CheckBox x:Name="FloatAutoCollapseCheck" Content="鼠标离开后自动收起"/>
            <CheckBox x:Name="FloatClickThroughCheck" Content="鼠标穿透模式"/>
            <TextBlock Text="穿透模式开启后，请用全局快捷键关闭或打开悬浮窗。" Style="{StaticResource Caption}" Margin="0,2,0,14"/>
            <TextBlock Text="透明度" FontWeight="SemiBold"/>
            <Slider x:Name="FloatOpacitySlider" Minimum=".55" Maximum="1" TickFrequency=".05" IsSnapToTickEnabled="True" Margin="0,10,0,18"/>
            <TextBlock Text="展开时显示数量" FontWeight="SemiBold"/>
            <Slider x:Name="FloatCountSlider" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"/>
            <TextBlock Text="拖动标题区域可移动；靠近屏幕边缘会自动吸附，并记住所在显示器的位置和尺寸。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StorageSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,58">
          <StackPanel>
            <TextBlock Text="存储与备份" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="数据库、原图和缩略图均保存在本地" Style="{StaticResource Caption}" Margin="0,4,0,20"/>
            <Border Style="{StaticResource GlassCard}">
              <StackPanel>
                <TextBlock x:Name="StorageTotalText" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="StorageDetailText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock Text="数据保存目录" FontWeight="SemiBold" Margin="0,8,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="DataRootBox" IsReadOnly="True"/>
              <Button Grid.Column="1" Content="更改…" Margin="8,0,0,0" Click="ChangeDataRoot_Click"/>
            </Grid>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="创建完整备份" Click="Backup_Click"/>
              <Button Grid.Column="2" Content="从备份恢复" Click="Restore_Click"/>
            </Grid>
            <TextBlock Text="容量与保留策略" FontWeight="SemiBold" Margin="0,22,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="最多记录条数" Style="{StaticResource Caption}"/><TextBox x:Name="MaxItemsBox" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="保留天数（0 = 永久）" Style="{StaticResource Caption}"/><TextBox x:Name="RetentionBox" Margin="0,6,0,0"/></StackPanel>
            </Grid>
            <TextBlock Text="收藏和置顶内容不会被自动清理。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Content="取消" Margin="0,0,8,0" Click="Cancel_Click"/>
          <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
