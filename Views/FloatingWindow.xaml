<Window x:Class="LumaClip.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumaClip 悬浮窗" Width="390" Height="560" MinWidth="300" MinHeight="350"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" UseLayoutRounding="True">
  <Grid>
    <Grid.Background>
      <ImageBrush ImageSource="/Assets/GlassBackground.png" Stretch="UniformToFill"
                  Opacity="{DynamicResource BackdropImageOpacity}"/>
    </Grid.Background>
    <Border x:Name="ExpandedPanel" Style="{StaticResource GlassInspector}" Background="{DynamicResource InspectorSurface}"
            CornerRadius="22" Padding="13" Effect="{StaticResource FloatShadow}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="DragHeader" Margin="4,1,1,10" Background="Transparent"
              MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentBrush}" Padding="3">
              <Image Source="/Assets/LumaClip-ui.png" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="9,0,0,0">
              <TextBlock Text="最近复制" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="双击即可重新复制" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE718;" Click="Topmost_Click" ToolTip="切换置顶"/>
            <Button x:Name="PresentationButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                    Content="&#xE7F4;" Margin="4,0,0,0" Click="Presentation_Click" ToolTip="切换到灵动岛"/>
            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                    Content="&#xE70D;" Margin="4,0,0,0" Click="Collapse_Click" ToolTip="收起为悬浮球"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE921;" Margin="4,0,0,0" Click="Hide_Click" ToolTip="隐藏"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="2,0,2,10">
          <TextBox x:Name="FloatSearchBox" Style="{StaticResource SearchTextBox}" Padding="32,7,10,7" TextChanged="FloatSearchBox_TextChanged"/>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0"/>
        </Grid>
        <ListBox x:Name="FloatList" Grid.Row="2" SelectionChanged="FloatList_SelectionChanged" MouseDoubleClick="FloatList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource InspectorGroup}" Padding="9" Margin="0,0,2,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding KindGlyph}" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Caption}" FontSize="9" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="25" Height="25" FontSize="11" Content="{Binding FavoriteGlyph}"
                          Tag="{Binding}" Click="FloatFavorite_Click"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" Style="{StaticResource PreviewSurface}" Padding="9" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="PreviewText" Text="单击记录预览" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="38" FontSize="11"/>
              <TextBlock x:Name="PreviewMeta" Style="{StaticResource Caption}" FontSize="9" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE718;" Click="FloatPin_Click" ToolTip="置顶"/>
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE74D;" Margin="4,0,0,0" Click="FloatDelete_Click" ToolTip="删除"/>
            </StackPanel>
          </Grid>
        </Border>
        <ResizeGrip Grid.RowSpan="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-8,-8" Opacity=".42"/>
      </Grid>
    </Border>

    <Border x:Name="OrbPanel" Visibility="Collapsed" Width="72" Height="72" CornerRadius="27"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource InspectorSurface}" BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="1"
            Effect="{StaticResource FloatShadow}" MouseLeftButtonDown="Orb_MouseLeftButtonDown">
      <Grid>
        <Border Width="56" Height="56" CornerRadius="20" Background="{DynamicResource AccentBrush}"
                BorderBrush="#66FFFFFF" BorderThickness="1">
          <Image Source="/Assets/LumaClip-ui.png" Width="48" Height="48" Stretch="Uniform"/>
        </Border>
        <Ellipse x:Name="NewDot" Width="10" Height="10" Fill="#FF30D158" Stroke="White" StrokeThickness="1.5"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <!-- Dynamic-Island compact presentation: one calm piece of material, not a miniature main window. -->
    <Border x:Name="IslandPanel" Visibility="Collapsed" Margin="5" CornerRadius="34"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="#EE14161A" BorderBrush="#40FFFFFF" BorderThickness="1"
            Effect="{StaticResource FloatShadow}" MouseLeftButtonDown="Island_MouseLeftButtonDown">
      <Grid Margin="10,7,8,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="18" Background="#FF0A84FF"
                BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center">
          <Grid>
            <Image Source="/Assets/LumaClip-ui.png" Width="38" Height="38" Stretch="Uniform"/>
            <Ellipse x:Name="IslandPulse" Width="9" Height="9" Fill="#FF30D158" Stroke="White" StrokeThickness="1.3"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,2,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="IslandLatestText" Text="剪贴板已就绪" Foreground="White"
                     FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="IslandMetaText" Text="本地保存 · 不上传" Foreground="#BFFFFFFF"
                     FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" MinWidth="26" Height="24" CornerRadius="12" Margin="0,0,5,0"
                Background="#20FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock x:Name="IslandCountText" Text="0" Foreground="White" FontSize="10"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="White"
                  FontFamily="Segoe Fluent Icons" Content="&#xE70D;" Click="IslandExpand_Click" ToolTip="展开面板"/>
          <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#D8FFFFFF"
                  FontFamily="Segoe Fluent Icons" Content="&#xE8A7;" Margin="2,0,0,0"
                  Click="IslandBackToPanel_Click" ToolTip="切回玻璃面板"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
